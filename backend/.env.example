# ADDITIONAL_CLIENT_ORIGINS=http://192.168.1.25:5173
COOKIE_SAME_SITE=lax
GITHUB_OWNER=Mouli372
GITHUB_REPO=MODSZONE-GAME-FILES
GITHUB_BRANCH=main
GITHUB_ACCESS_MODE=redirect
